#!/bin/bash

# [description]
#
#   Installs 'gha-tools' and puts it at /usr/local/bin so no PATH modification is required.
#

set -e -u -o pipefail

GHA_TOOLS_INSTALL_DIR="${GHA_TOOLS_INSTALL_DIR:-/usr/local/bin}"
archive="$(mktemp)"
trap 'rm -f -- "$archive"' EXIT

# install wget
wget_preinstalled=true

if ! type -f wget >/dev/null; then
  echo "could not find 'wget', installing it"
  wget_preinstalled=false
  i=0
  until apt-get update -y; do
    ((++i >= 5)) && break;
    sleep 10;
  done
  apt-get install -y --no-install-recommends \
    wget
fi

# install gha-tools
wget -q --tries=4 --retry-on-http-error=429,500,502,503,504 --waitretry=10 \
  https://github.com/rapidsai/gha-tools/releases/latest/download/tools.tar.gz -O "$archive"
tar -xzf "$archive" -C "${GHA_TOOLS_INSTALL_DIR}"

# uninstall wget
if [[ "${wget_preinstalled}" != "true" ]]; then
  apt-get purge -y wget
  apt-get autoremove -y
  rm -rf /var/lib/apt/lists/*
fi
