"""Export pip-installed distributions with their canonical PyPI pURLs."""

from __future__ import annotations

import json
import re
import sys
from importlib import metadata
from pathlib import Path


def main() -> None:
    output = Path(sys.argv[1])
    packages = []
    for distribution in metadata.distributions():
        name = str(distribution.metadata.get("Name") or "").strip()
        version = str(distribution.version or "").strip()
        installer = (distribution.read_text("INSTALLER") or "").strip().lower()
        if not name or not version or installer != "pip":
            continue
        normalized_name = re.sub(r"[-_.]+", "-", name).lower()
        packages.append(
            {
                "name": name,
                "version": version,
                "purls": [f"pkg:pypi/{normalized_name}"],
                "installer": "pip",
                "evidence": "python-distribution-metadata; INSTALLER=pip",
            }
        )
    output.write_text(
        json.dumps(sorted(packages, key=lambda item: item["name"].lower())),
        encoding="utf-8",
    )


if __name__ == "__main__":
    main()
